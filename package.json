{
  "name": "arizo-agent",
  "version": "3.5.5",
  "private": true,
  "license": "MIT",
  "author": "ArizoOwner",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "web": "npm run dev --prefix web",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --lib && npm test --prefix web",
    "pack": "tauri build && node scripts/pack.mjs",
    "release": "node scripts/release.mjs",
    "icons": "node scripts/gen-icons.mjs && node scripts/gen-installer-art.mjs",
    "installer-art": "node scripts/gen-installer-art.mjs",
    "sounds": "node scripts/gen-sounds.mjs",
    "readme-art": "node scripts/gen-readme-art.mjs",
    "readme-gifs": "node scripts/readme-gifs/record.mjs",
    "readme-gifs:all": "node scripts/readme-gifs/all.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0"
  }
}
